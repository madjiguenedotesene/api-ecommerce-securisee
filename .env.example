# Copier en .env et remplacer toutes les valeurs (ne jamais committer .env)
# Clé de signature des jetons, 32 caractères minimum :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://boutique:${POSTGRES_PASSWORD}@db:5432/boutique

# Administrateur créé au premier démarrage (aucun administrateur n'est créé par inscription)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Origines autorisées pour le front-end, séparées par des virgules (vide = CORS désactivé)
ORIGINES_CORS=http://localhost:3000
